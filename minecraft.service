[Unit]
Description=Minecraft server!
After=network.target
RequiresMountsFor=/srv/minecraft/

[Service]
Type=simple
WorkingDirectory=/srv/minecraft/
User=minecraft
Group=minecraft

ProtectProc=invisible
NoNewPrivileges=yes
UMask=0027
TimerSlackNSec=5ms
ProtectSystem=strict
ProtectHome=yes
NoExecPaths=/
InaccessiblePaths=-/boot -/efi -/home -/mnt -/media -/opt -/root -/var
ExecPaths=-/usr/bin -/usr/local/bin -/usr/lib -/usr/lib64 -/usr/libexec
ReadWritePaths=/srv/minecraft/
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
MountAPIVFS=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
PrivateMounts=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native

KillSignal=SIGCONT
Sockets=minecraft.socket
ExecStart=/bin/sh -c "java -Xmx5G -jar server1.21.10.jar < /run/minecraft.control"
ExecStop=/bin/sh -c "echo /stop > /run/minecraft.control"

[Install]
WantedBy=multi-user.target